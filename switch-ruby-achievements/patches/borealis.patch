 void AppletFrameItem::setHintView(View* hintView)
 {
     this->hintView = hintView;
@@ -614,6 +616,14 @@ void View::drawHighlight(NVGcontext* vg, Theme theme, float alpha, Style style,
         nvgFillPaint(vg, shadowPaint);
         nvgFill(vg);
 
+        // Switch Playtime: borda desenhada pelo app (ver highlightBorderDrawer).
+        if (highlightBorderDrawer)
+        {
+            highlightBorderDrawer(vg, x, y, width, height, cornerRadius, alpha * this->getAlpha());
+            nvgRestore(vg);
+            return;
+        }
+
         // Border
         float gradientX, gradientY, color;
         getHighlightAnimation(&gradientX, &gradientY, &color);
diff --git a/library/lib/extern/nanovg/deko3d/dk_renderer.cpp b/library/lib/extern/nanovg/deko3d/dk_renderer.cpp
