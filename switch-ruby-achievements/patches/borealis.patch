@@ -533,6 +533,17 @@ namespace nvg {
             /* Update buffers with data. */
             this->UpdateVertexBuffer(ctx.verts, ctx.nverts * sizeof(NVGvertex));
 
+            /* Switch Playtime (patch local): sem memória para os vértices, descarta o
+               quadro em vez de usar um buffer vazio (fechava o app). */
+            if (!m_vertex_buffer) {
+                m_dyn_cmd_buf.clear();
+                ctx.nverts = 0;
+                ctx.npaths = 0;
+                ctx.ncalls = 0;
+                ctx.nuniforms = 0;
+                return;
+            }
+
             /* Enable blending. */
             m_dyn_cmd_buf.bindColorState(dk::ColorState{}.setBlendEnable(0, true));
 
