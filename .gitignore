achievement_seen.txt
ghost_icon.jpg

# --- Logs (trazem UIDs de conta do console) ----------------------------------
*.log
/logs/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Memória local da IA (ai-memory, Claude Code): nunca no Git ---------------
ai-memory/
.ai-memory/
*ai-memory*
*ai_memory*
.claude/

# --- Só na cópia local (fora do repositório público) -------------------------
